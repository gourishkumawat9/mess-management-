# Copy to .env and adjust. Never commit .env.

# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Signs login sessions. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: only allow sign-ups from these email domains (comma separated).
# Leave empty to allow any email, e.g. while testing.
ALLOWED_EMAIL_DOMAINS="iimsambalpur.ac.in"

# Passwords for the demo accounts created by `npm run db:seed`.
SEED_ADMIN_PASSWORD="Admin@123"
SEED_STAFF_PASSWORD="Staff@123"
SEED_STUDENT_PASSWORD="Student@123"
