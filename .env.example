# Copy to .env and adjust. Never commit .env.

# PostgreSQL. These match `docker compose up -d`; for a free hosted database,
# paste a Neon connection string instead. DATABASE_URL_UNPOOLED is the direct
# (non-pooled) connection used for migrations; locally it can be the same URL.
DATABASE_URL="postgresql://mess:mess@localhost:5432/mess"
DATABASE_URL_UNPOOLED="postgresql://mess:mess@localhost:5432/mess"

# Signs login sessions. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: only allow sign-ups from these email domains (comma separated).
# Leave empty to allow any email, e.g. while testing.
ALLOWED_EMAIL_DOMAINS="iimsambalpur.ac.in"

# Starting data loaded by `npm run setup` / `npm run db:seed` (and by each Vercel
# deploy into an empty database).
# On a live site SEED_ADMIN_PASSWORD is required and the demo passwords below
# are never used; demo staff/student accounts get random passwords there.
SEED_ADMIN_EMAIL="admin@iimsambalpur.ac.in"
SEED_ADMIN_PASSWORD="Admin@123"
SEED_STAFF_PASSWORD="Staff@123"
SEED_STUDENT_PASSWORD="Student@123"
# Set to "false" to start with no demo orders, demo accounts or stock history.
SEED_DEMO_DATA="true"
